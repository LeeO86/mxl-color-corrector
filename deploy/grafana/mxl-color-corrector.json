{
  "title": "MXL Color Corrector",
  "uid": "mxl-color-corrector",
  "schemaVersion": 39,
  "refresh": "5s",
  "panels": [
    {
      "type": "stat",
      "title": "Slice mode",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "mxl_color_corrector_slice_mode", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Clipped ratio",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "mxl_color_corrector_clipped_ratio", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Added latency",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "histogram_quantile(0.99, sum by (le, channel) (rate(mxl_color_corrector_added_latency_seconds_bucket[1m])))", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Grains",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{ "expr": "rate(mxl_color_corrector_grains_processed_total[1m])", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Processing time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [{ "expr": "histogram_quantile(0.99, sum by (le, channel) (rate(mxl_color_corrector_processing_seconds_bucket[1m])))", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Late grains",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "mxl_color_corrector_late_grains_total", "refId": "A" }]
    }
  ]
}
